[Unit]
Description=Wedding app API (Express + SQLite)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/wedding-api
EnvironmentFile=/opt/wedding-api/api.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
