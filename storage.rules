rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin(){
      return request.auth != null;
    }

    // Guests may upload a photo / video / audio clip up to 64 MB, once per path.
    function guestUpload(){
      return resource == null
        && request.resource.size < 64 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType.matches('audio/.*'));
    }

    match /memories/{id}/{fileName} {
      allow read: if true;
      allow create: if guestUpload();
      allow update, delete: if isAdmin();
    }

    match /guestbook/{id}/{fileName} {
      allow read: if true;
      allow create: if guestUpload() && request.resource.contentType.matches('image/.*');
      allow update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
