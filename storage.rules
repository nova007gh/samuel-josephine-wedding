rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Memories (photos, videos, voice messages)
    match /memories/{id}/{fileName} {
      allow read: if true;   // gallery displays
      allow write: if true;  // guest uploads
      allow delete: if true; // admin removes
    }

    // Guestbook selfies
    match /guestbook/{id}/{fileName} {
      allow read: if true;   // guestbook displays
      allow write: if true;  // guest uploads
      allow delete: if true; // admin removes
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
